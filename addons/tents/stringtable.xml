        <Key ID="STR_avo_tents_Setting_Enabled_Description">
            <English>Allows setting up tents from packed tent items and packing placed tents up again.</English>
            <German>Erlaubt es, Zelte aus Zeltpacks aufzubauen und aufgestellte Zelte wieder abzubauen.</German>
        </Key>
        <Key ID="STR_avo_tents_Setting_Enabled_DisplayName">
